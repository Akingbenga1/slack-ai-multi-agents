# Service URLs (Compose defaults)
DATABASE_URL=postgresql+psycopg://csa:csa@localhost:5433/csa
REDIS_URL=redis://localhost:6379/0
# Job queue (Sprint 38) — celery is the demo default; rq/dramatiq are documented stubs only
JOB_QUEUE=celery
# Vector store (Sprint 35) — qdrant is the demo default; pgvector is a documented stub only
VECTOR_STORE=qdrant
# Qdrant-adapter secrets (do not rename)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge
# Embedding provider (Sprint 35) — tei is the demo default; ollama/openai documented stubs only
EMBEDDING_PROVIDER=tei
# TEI-adapter secrets (do not rename)
TEI_URL=http://localhost:8080
# Must match docker-compose TEI --model-id (bge-small-en-v1.5 → 384)
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Public / auth
PUBLIC_BASE_URL=http://localhost:8000
# MCP Connect/OAuth (remote HTTP) — required for Connect button on Org Tools
# Redirect defaults to {PUBLIC_BASE_URL}/mcp-servers/oauth/callback
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_REDIRECT_PATH=/mcp-servers/oauth/callback
# MCP_OAUTH_SCOPES=
# Next.js origin (Stripe Checkout / Portal return URLs). Also used for invite magic-links.
# Public /signup reuses JWT_SECRET + WEB_APP_URL + NEXTAUTH_* — no extra signup keys.
WEB_APP_URL=http://localhost:3000
# development | staging | production — staging/production require a strong JWT_SECRET
APP_ENV=development
# Identity provider (Sprint 36) — credentials is the demo default; oidc/saml/google/microsoft are stubs only
IDENTITY_PROVIDER=credentials
JWT_SECRET=dev-change-me-use-at-least-32-chars!!
# Optional separate key for Slack bot token encryption (defaults to JWT_SECRET)
# TOKEN_ENCRYPTION_KEY=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Expose /debug/* routes (set false in production)
DEBUG_ENDPOINTS_ENABLED=true

# Blob store (Sprint 37) — local is the demo default; s3 is a documented stub only
BLOB_STORE=local
# Local-adapter root (do not rename) — relative to process cwd; default data/uploads
UPLOAD_DIR=data/uploads

# LLM / agent — role-named configuration (preferred)
# Registered LLM_PROVIDER ids: stub | anthropic | ollama | openai_compat
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_FAST=claude-3-5-haiku-latest
LLM_MODEL_CAPABLE=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1024
# LLM_BASE_URL=                        # required for openai_compat / remote backends
# Legacy aliases (deprecated — migrate to LLM_* vars above):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_HAIKU=claude-3-5-haiku-latest
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=1024
# OLLAMA_URL=http://localhost:11434      # when LLM_PROVIDER=ollama
# OLLAMA_MODEL_FAST=llama3.2
# OLLAMA_MODEL_CAPABLE=llama3.1
# OLLAMA_MAX_TOKENS=1024
# ORCHESTRATOR_MAX_TOKENS=4096
# Tool RAG — planner shortlist (clamped 5–20)
# TOOL_RAG_TOP_K=12
# TOOL_RAG_USE_EMBEDDINGS=true
# TOOL_RAG_WORKFLOW_BODY_CHARS=1500
# AGENT_RETRIEVE_TOP_K=8
# AGENT_MIN_SCORE=0.70          # cosine; below → hard hedge
# AGENT_CHECKPOINTER=postgres   # or memory
# AGENT_RETRIEVE_BACKEND=mcp    # mcp (default) | direct (in-process)
# AGENT_MCP_TRANSPORT=in_process  # in_process | stdio
# AGENT_MCP_COMMAND=            # optional; default = current python
# AGENT_MCP_ARGS=               # optional; default = -m mcp_server
# AGENT_MCP_TIMEOUT_SECONDS=60.0
# AGENT_RETRIEVE_MAX_TOP_K=32
# AGENT_MAX_CHECKPOINT_MESSAGES=40

# Plan-and-execute (Sprint 46) — feature flag for plan/execute facade
# PLAN_EXECUTE_ENABLED=false

# Host CLI check/install control plane (admin UI /cli-host — not agent runtime)
# CLI_HOST_INSTALL_ENABLED=true
# CLI_HOST_INSTALL_TIMEOUT_SECONDS=300
MCP_HOST_CHECK_TIMEOUT_SECONDS=20

# System-wide tool discovery (not tenant-scoped). Callers send a query only.
# CLI: portable tldr SQLite DB (default: project-root tldr_pages.db).
# DISCOVERY_CLI_DB_PATH=tldr_pages.db
# DISCOVERY_CLI_SEARCH_LIMIT=15
# Celery Beat refresh interval (seconds; default 7 days)
# DISCOVERY_CLI_UPDATE_INTERVAL_SECONDS=604800
# MCP: Official MCP Registry base URL (required for /discovery/mcp-tools).
DISCOVERY_MCP_SERVICE_URL=https://registry.modelcontextprotocol.io
# DISCOVERY_MCP_SEARCH_LIMIT=10
# DISCOVERY_MCP_CACHE_TTL_SECONDS=300
# DISCOVERY_HTTP_SERVICE_URL=
# DISCOVERY_TIMEOUT_SECONDS=45.0


# Slack (Sprint 4+) — see docs/slack-app-setup.md
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Event transport: http (Events API + public URL) | socket (Socket Mode, no events tunnel)
SLACK_EVENTS_TRANSPORT=http
# App-level token (xapp-…) — required when SLACK_EVENTS_TRANSPORT=socket
SLACK_APP_TOKEN=
# Sprint 9 — Beat dispatcher interval for live history sync (seconds; default 1h)
# SLACK_HISTORY_SYNC_INTERVAL_SECONDS=3600
# Bound in-memory backlog while syncing a channel (messages per ingest batch)
# SLACK_SYNC_INGEST_BATCH_SIZE=100
# Sprint 17 — recurring report Beat intervals (seconds)
# RECURRING_REPORT_DAILY_INTERVAL_SECONDS=86400
# RECURRING_REPORT_WEEKLY_INTERVAL_SECONDS=604800

# Stripe (Sprint 11+)
# Payment gateway (Sprint 34) — stripe is the demo default; paypal is a documented stub only
PAYMENT_PROVIDER=stripe
# Stripe-adapter secrets (do not rename)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Governance (Sprint 12+) — per-tenant gateway requests per minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
# When false, Redis errors deny requests instead of allowing unlimited traffic
RATE_LIMIT_FAIL_OPEN=true

# Demo seed hardening (Sprint 22.1) — laptop demo without live Stripe/OAuth
# DEMO_ACTIVATE_PLAN=true
# DEMO_SLACK_TEAM_ID=
# DEMO_SLACK_BOT_TOKEN=
# DEMO_REPORT_CHANNEL_ID=

# Sprint 32 — admin plan waivers (policy guardrail; unset = allow in development only)
# ALLOW_PLAN_WAIVERS=true

# Next.js (also copy into web/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
# IDENTITY_PROVIDER is shared with the API (credentials default); copy into web/.env.local too
# STRIPE_PUBLISHABLE_KEY=
