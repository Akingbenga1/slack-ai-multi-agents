# Service URLs (Compose defaults)
DATABASE_URL=postgresql+psycopg://csa:csa@localhost:5433/csa
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge
TEI_URL=http://localhost:8080
# Must match docker-compose TEI --model-id (bge-small-en-v1.5 → 384)
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Public / auth
PUBLIC_BASE_URL=http://localhost:8000
# Next.js origin (Stripe Checkout / Portal return URLs)
WEB_APP_URL=http://localhost:3000
JWT_SECRET=dev-change-me-use-at-least-32-chars!!

# Uploads (Sprint 8) — relative to process cwd; default data/uploads
UPLOAD_DIR=data/uploads

# LLM / agent (Sprint 13+)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_HAIKU=claude-3-5-haiku-latest
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=1024
# AGENT_RETRIEVE_TOP_K=8
# AGENT_MIN_SCORE=0.70          # cosine; below → hard hedge
# AGENT_CHECKPOINTER=postgres   # or memory
# AGENT_RETRIEVE_BACKEND=mcp    # mcp (default) | direct (in-process)
# AGENT_MCP_COMMAND=            # optional; default = current python
# AGENT_MCP_ARGS=               # optional; default = -m mcp_server

# Slack (Sprint 4+) — see docs/slack-app-setup.md
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Sprint 9 — Beat dispatcher interval for live history sync (seconds; default 1h)
# SLACK_HISTORY_SYNC_INTERVAL_SECONDS=3600
# Sprint 17 — recurring report Beat intervals (seconds)
# RECURRING_REPORT_DAILY_INTERVAL_SECONDS=86400
# RECURRING_REPORT_WEEKLY_INTERVAL_SECONDS=604800

# Stripe (Sprint 11+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Governance (Sprint 12+) — per-tenant gateway requests per minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# Demo seed hardening (Sprint 22.1) — laptop demo without live Stripe/OAuth
# DEMO_ACTIVATE_PLAN=true
# DEMO_SLACK_TEAM_ID=
# DEMO_SLACK_BOT_TOKEN=
# DEMO_REPORT_CHANNEL_ID=

# Next.js (also copy into web/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
# STRIPE_PUBLISHABLE_KEY=
